# The HTML shell must always revalidate so a new deploy's asset hashes are picked
# up immediately — never serve a stale index.html that references pruned assets.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store

# Service worker must not be cached at the edge — updates need to ship immediately.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=300

# Hashed Vite assets — long cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
