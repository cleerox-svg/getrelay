{
  "name": "@relay/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "shoot:golf": "node scripts/shoot-golf.mjs",
    "shoot:baseball": "node scripts/shoot-baseball.mjs",
    "icons": "node scripts/build-icons.mjs",
    "store-assets": "node scripts/build-store-assets.mjs",
    "cap:sync": "cap sync android",
    "cap:add:android": "cap add android",
    "cap:assets": "capacitor-assets generate --android --assetPath assets",
    "android:build:debug": "pnpm build && pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "cap:sync:ios": "cap sync ios",
    "cap:add:ios": "cap add ios",
    "cap:assets:ios": "capacitor-assets generate --ios --assetPath assets",
    "ios:open": "pnpm build && pnpm cap:sync:ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/push-notifications": "^6.0.4",
    "@codetrix-studio/capacitor-google-auth": "3.4.0-rc.4",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "jsqr": "^1.4.0",
    "konsta": "4.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "three": "^0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
